model Student {
  id      Int     @id @default(autoincrement())
  name    String
  idCard  IdCard?              // 👈 optional, single object — "one" পক্ষ
}

model IdCard {
  id         Int     @id @default(autoincrement())
  cardNumber String
  studentId  Int     @unique   // 👈 @unique-ই একে One-to-One বানাচ্ছে
  student    Student @relation(fields: [studentId], references: [id])
}